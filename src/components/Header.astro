---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const basePath = base.replace(/\/$/, '');
const currentPath =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href={base} class="font-display text-orange-700 text-3xl font-medium tracking-tight transition-colors hover:text-signal">
      {SITE.name}
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={`${base}${link.href.slice(1)}`}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
