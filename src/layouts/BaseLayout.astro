---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og-image.png' } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YPBYJQS4WG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-YPBYJQS4WG');
    </script>
    <!-- End Google Tag -->
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body id="top" class="bg-paper text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
