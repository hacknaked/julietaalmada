---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og-image.jpg' } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <script is:inline>
      function loadGoogleAnalytics() {
        if (window.googleAnalyticsLoaded) return;

        window.googleAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-YPBYJQS4WG');

        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-YPBYJQS4WG';
        document.head.append(script);
      }

      function scheduleGoogleAnalytics() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadGoogleAnalytics, { timeout: 4000 });
        } else {
          window.setTimeout(loadGoogleAnalytics, 2000);
        }
      }

      if (document.readyState === 'complete') {
        scheduleGoogleAnalytics();
      } else {
        window.addEventListener('load', scheduleGoogleAnalytics, { once: true });
      }
    </script>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body id="top" class="bg-paper text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
