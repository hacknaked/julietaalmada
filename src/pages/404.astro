---
import BaseLayout from '@/layouts/BaseLayout.astro';

const homePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Página no encontrada">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-6 py-32">
    <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">404</p>
    <h1 class="font-display text-ink text-3xl font-medium">Esta página no existe.</h1>
    <p class="text-ink-soft">El enlace puede estar roto o la página puede haber cambiado de lugar.</p>
    <a href={homePath} class="text-signal font-mono text-sm hover:underline">← Volver al inicio</a>
  </section>
</BaseLayout>
