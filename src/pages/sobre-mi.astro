---
import { Picture } from 'astro:assets';
import portraitImage from '@/assets/images/juli2.jpg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';

const tools = ['TypeScript', 'Astro', 'React', 'Figma', 'Tailwind CSS', 'Node.js'];
---

<BaseLayout
  title="Sobre mí"
  description={'Conocé más sobre mi formación, experiencia y la manera en que acompaño a niños, adolescentes y familias en sus procesos de aprendizaje.'}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">Sobre mí</p>
    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      Hola, soy Julieta Almada,<br /> licenciada en psicopedagogía y docente
    </h1>
    <div class="grid items-start gap-12 md:grid-cols-[minmax(0,1fr)_16rem]">
      <div>
        <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
          <p>
            Desde pequeña me interesa el aprendizaje. La curiosidad me llevó siempre a querer saber
            un poco más, conocer algo diferente, entender cómo funciona el mundo.
          </p>
          <p>
            Durante mi adolescencia, en rondas y encuentros para estudiar, comenzó mi camino de
            observación: mirar, preguntarme y tratar de descifrar cómo aprendían los otros.
          </p>
          <p>
            Hoy, continúo con esa mente de principiante acompañando los aprendizajes de niños,
            niñas, adolescentes y sus contextos familiares, educativos o sociales.
          </p>
        </div>
        <Button href="/#hablemos" class="mt-10">Hablemos</Button>
      </div>

      <Picture
        src={portraitImage}
        formats={['avif', 'webp']}
        layout="constrained"
        width={256}
        alt="Julieta Almada"
        loading="eager"
        class="mx-auto w-full max-w-64 rounded-full"
      />
    </div>
  </section>
</BaseLayout>
